#!/bin/bash
#SBATCH --account=vsharan_1861                         
#SBATCH --partition=gpu                                                         
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gpus-per-task=1                                                       # Any available GPU gets alloted. If you need stronger computing, change the value to "a100:1"
#SBATCH --cpus-per-task=8                              
#SBATCH --mem=32GB                                                              # Increase if you need more memory
#SBATCH --time=08:00:00                                                         # Change the time based on your requirement
#SBATCH --job-name=mtl_run                              
#SBATCH --output=/project2/vsharan_1861/mtl_grad_conf/logs/%j_%x.out
#SBATCH --error=/project2/vsharan_1861/mtl_grad_conf/logs/%j_%x.err
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=YOUR_EMAIL                                                  # Change to your email

echo "=========================================="
echo "Job ID:        $SLURM_JOB_ID"
echo "Job Name:      $SLURM_JOB_NAME"
echo "Started:       $(date)"
echo "=========================================="

# Load required modules
module purge
module load python/3.10

# Activate your personal virtual environment
source ~/mtl_env/bin/activate

# Shared project storage
export HF_DATASETS_CACHE="/project2/vsharan_1861/mtl_grad_conf/hf_cache"
export TRANSFORMERS_CACHE="/project2/vsharan_1861/mtl_grad_conf/hf_cache"
export MTL_RESULTS_DIR="/project2/vsharan_1861/mtl_grad_conf/results"

# Create logs dir if it doesn't exist
mkdir -p /project2/vsharan_1861/mtl_grad_conf/logs

cd ~/mtl_gradient_conflict

# Vanilla MTL experiments
python YOUR_SCRIPT.py \
    --arg1 value1 \
    --arg2 value2

echo ""
echo "=========================================="
echo "Finished: $(date)"
echo "=========================================="